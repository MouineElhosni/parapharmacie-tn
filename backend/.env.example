# Server
PORT=5000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change_me
DB_NAME=ecommerce
# Set to "true" on hosted DBs (Render/Neon) - use internal cert handling
DB_SSL=false

# Source MySQL (XAMPP) - used only by scripts/migrate-mysql-to-pg.js
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_NAME=ecommerce

# JWT (change this in production!)
JWT_SECRET=change_me_in_production
JWT_EXPIRES=1d

# CORS (comma-separated list of allowed origins, or * for all)
CORS_ORIGIN=*

# Notification WhatsApp automatique vers le magasin (CallMeBot)
# 1) Depuis le numéro du magasin, envoyez à CallMeBot (+34 603 21 25 97) :
#    "I allow callmebot to send me messages"
# 2) Récupérez votre API key et renseignez-la ici
# STORE_WHATSAPP=21658940189
# CALLMEBOT_APIKEY=votre_cle

# Notifications nouveautés par email (SMTP - ex: Gmail "Mots de passe d'application")
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=votre_email@gmail.com
# SMTP_PASS=votre_mot_de_passe_application
# SMTP_FROM="Parapharmacie.Tn <votre_email@gmail.com>"

# URL publique du site (liens dans les emails/WhatsApp)
# SITE_URL=https://parapharmacie-tn.onrender.com
